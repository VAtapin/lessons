  "sheep": {
    "slides": [
      {
        "number": 1,
        "text": [
          "Потерянная",
          "овечка",
          "5–7 лет   35 минут"
        ],
        "media": {
          "assetId": "builtin-illustrated-sheep-1",
          "versionId": "builtin-illustrated-sheep-1-v1"
        },
        "sha256": "2e07c57bee98a8f0b69199dcdf79d30450ae0c89897e9e515fbea1641f9afec2"
      },
      {
        "number": 2,
        "text": [
          "Наше маленькое стадо",
          "Сколько овечек в нашей игре?"
        ],
        "media": {
          "assetId": "builtin-illustrated-sheep-2",
          "versionId": "builtin-illustrated-sheep-2-v1"
        },
        "sha256": "b6b11aa84ad40d6afd8a7061f612a8466f3c3fae89163e1bf3a63d5f3610d331"
      },
      {
        "number": 3,
        "text": [
          "Одной не хватает",
          "Кого не хватает?"
        ],
        "media": {
          "assetId": "builtin-illustrated-sheep-3",
          "versionId": "builtin-illustrated-sheep-3-v1"
        },
        "sha256": "b6b11aa84ad40d6afd8a7061f612a8466f3c3fae89163e1bf3a63d5f3610d331"
      },
      {
        "number": 4,
        "text": [
          "Чей это голос?",
          "Ш-ш-ш",
          "Буль-буль",
          "Ме-е"
        ],
        "media": {
          "assetId": "builtin-illustrated-sheep-4",
          "versionId": "builtin-illustrated-sheep-4-v1"
        },
        "sha256": "b6b11aa84ad40d6afd8a7061f612a8466f3c3fae89163e1bf3a63d5f3610d331"
      },
      {
        "number": 5,
        "text": [
          "Где овечка?"
        ],
        "media": {
          "assetId": "builtin-illustrated-sheep-5",
          "versionId": "builtin-illustrated-sheep-5-v1"
        },
        "sha256": "36f886531ce4a7dce091f7d5b19b50bba1a0ff459f9ba7a298e0b922af705a7d"
      },
      {
        "number": 6,
        "text": [
          "Пастух нашёл овечку",
          "Он радуется",
          "и бережно несёт",
          "овечку.",
          "Лк. 15:5"
        ],
        "media": {
          "assetId": "builtin-illustrated-sheep-6",
          "versionId": "builtin-illustrated-sheep-6-v1"
        },
        "sha256": "9c586f661c67e5b65600dad76b4b1dc5febb348db2db5a17a057ad12a4325534"
      },
      {
        "number": 7,
        "text": [
          "Радость вместе",
          "Пастух: «Я нашёл овечку!»",
          "Друзья: «Мы рады!»"
        ],
        "media": {
          "assetId": "builtin-illustrated-sheep-7",
          "versionId": "builtin-illustrated-sheep-7-v1"
        },
        "sha256": "9c586f661c67e5b65600dad76b4b1dc5febb348db2db5a17a057ad12a4325534"
      },
      {
        "number": 8,
        "text": [
          "Наш настольный театр",
          "Ищем",
          "Нашли",
          "Радуемся"
        ],
        "media": {
          "assetId": "builtin-illustrated-sheep-8",
          "versionId": "builtin-illustrated-sheep-8-v1"
        },
        "sha256": "b6b11aa84ad40d6afd8a7061f612a8466f3c3fae89163e1bf3a63d5f3610d331"
      },
      {
        "number": 9,
        "text": [
          "Что было сначала?",
          "Нашёл",
          "Одной нет",
          "Радуется",
          "Ищет"
        ],
        "media": {
          "assetId": "builtin-illustrated-sheep-9",
          "versionId": "builtin-illustrated-sheep-9-v1"
        },
        "sha256": "36f886531ce4a7dce091f7d5b19b50bba1a0ff459f9ba7a298e0b922af705a7d"
      },
      {
        "number": 10,
        "text": [
          "История по порядку",
          "1. Одной нет",
          "2. Ищет",
          "3. Нашёл",
          "4. Радуется"
        ],
        "media": {
          "assetId": "builtin-illustrated-sheep-10",
          "versionId": "builtin-illustrated-sheep-10-v1"
        },
        "sha256": "9c586f661c67e5b65600dad76b4b1dc5febb348db2db5a17a057ad12a4325534"
      },
      {
        "number": 11,
        "text": [
          "Радость о возвращении",
          "Бог рад, когда люди",
          "возвращаются к Нему.",
          "Лк. 15:7",
          "«Прости меня. Я хочу помириться»."
        ],
        "media": {
          "assetId": "builtin-illustrated-sheep-11",
          "versionId": "builtin-illustrated-sheep-11-v1"
        },
        "sha256": "9c586f661c67e5b65600dad76b4b1dc5febb348db2db5a17a057ad12a4325534"
      },
      {
        "number": 12,
        "text": [
          "Приглашение в игру",
          "«Хочешь строить",
          "с нами?»",
          "«Я покажу,",
          "как начать»."
        ],
        "media": {
          "assetId": "builtin-illustrated-sheep-12",
          "versionId": "builtin-illustrated-sheep-12-v1"
        },
        "sha256": "e0ec9a5299b1ac9f60f67413397bf5e427a4aae73f0321f7841cfffb2e8d4daf"
      },
      {
        "number": 13,
        "text": [
          "Помощь в действии",
          "Кубик далеко",
          "Не знаю, как начать",
          "Я пока стою рядом"
        ],
        "media": {
          "assetId": "builtin-illustrated-sheep-13",
          "versionId": "builtin-illustrated-sheep-13-v1"
        },
        "sha256": "e0ec9a5299b1ac9f60f67413397bf5e427a4aae73f0321f7841cfffb2e8d4daf"
      },
      {
        "number": 14,
        "text": [
          "Каждый дорог Богу",
          "Пастух искал и нашёл овечку.",
          "Он радовался.",
          "Какую заботу я покажу",
          "на этой неделе?"
        ],
        "media": {
          "assetId": "builtin-illustrated-sheep-14",
          "versionId": "builtin-illustrated-sheep-14-v1"
        },
        "sha256": "f2aacdcda09553f140b667258c4a92dcb2e80720d582ddc2f85cff5a52bb96ca"
      }
    ],
    "mapping": [
      [
        1
      ],
      [
        2,
        3
      ],
      [
        4
      ],
